# ==========================================
# DevBoard Configuration Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_PREFIX=/api/v1

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/devboard
# For Docker or Atlas, e.g.:
# MONGODB_URI=mongodb://mongo:27017/devboard

# Redis Configuration (Optional, falls back to in-memory LRU cache if unavailable)
REDIS_URL=redis://localhost:6379
# For Docker:
# REDIS_URL=redis://redis:6379

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_secure_cookie_signing_secret_here

# File Upload & Storage (local | cloudinary | s3)
STORAGE_PROVIDER=local
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=./uploads

# Cloudinary (Optional - used if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notification (Nodemailer - async queue)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DevBoard Support" <no-reply@devboard.io>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=15

# AI Job Description Assistant (Optional)
ENABLE_AI_JOB_ASSIST=false
GEMINI_API_KEY=
OPENAI_API_KEY=
